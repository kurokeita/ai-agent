{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "AskUserQuestion|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${HOOKS_DIR}/commit-gate.py",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${HOOKS_DIR}/commit-gate.py",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${HOOKS_DIR}/commit-gate.py",
						"timeout": 10
					}
				]
			}
		]
	}
}
